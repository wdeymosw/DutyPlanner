<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DutyPlanner</AssemblyName>
    <RootNamespace>DutyPlanner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Views\**" />
    <EmbeddedResource Remove="Views\**" />
    <None Remove="Views\**" />
    <Page Remove="Views\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Presentation\Resources\Images\Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Presentation\Resources\Localization\Strings.en.xaml" />
    <Page Remove="Presentation\Resources\Localization\Strings.ru.xaml" />
    <Page Remove="Presentation\Resources\Localization\Strings.uk.xaml" />
  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="FontAwesome5.WPF" Version="1.0.5" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="QuestPDF" Version="2025.12.2" />
  </ItemGroup>



  <ItemGroup>
    <Resource Include="Presentation\Resources\Images\Logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Presentation\Resources\Localization\Strings.en.xaml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Presentation\Resources\Localization\Strings.ru.xaml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Presentation\Resources\Localization\Strings.uk.xaml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
