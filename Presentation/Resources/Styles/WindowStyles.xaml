<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:beh="clr-namespace:DutyPlanner.Presentation.Behaviors">


   

    <Style x:Key="AppWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AllowsTransparency" Value="True" />



        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome
                    CaptionHeight="12"
                    ResizeBorderThickness="6"
                    GlassFrameThickness="0"
                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <!-- Outer border with the dropshadow margin -->
                    <Border Margin="{Binding RelativeSource={RelativeSource TemplatedParent},
                            Path=(beh:WindowGeometryBehavior.OuterMargin)}"
                            Background="{StaticResource WindowShadowBrush}"
                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent},
                                Path=(beh:WindowGeometryBehavior.CornerRadius)}"
                             BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="2"
                            >
                        <Grid >
                            <Border CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent},
                                Path=(beh:WindowGeometryBehavior.CornerRadius)}"
                                        Background="{StaticResource BackgroundBrushLight}"
                                    IsHitTestVisible="True">
                               

                                <Grid>
                                    <DockPanel>


                                        <!-- 🔝 Title bar -->
                                        <Grid Height="auto" DockPanel.Dock="Top" IsHitTestVisible="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Padding="10 2 5 2">
                                                <Image Source="/Presentation/Resources/Images/Logo.png"
                                                       Width="30" 
                                                       Height="30" 
                                                       Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="10 2" Grid.Column="1">
                                               

                                                <TextBlock FontSize="24" FontWeight="Bold" Margin="3 0" Foreground="{StaticResource ButtonFontColorBrush}">
                                                     Duty
                                                </TextBlock>
                                                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource BorderBrush}">
                                                    Planer
                                                </TextBlock>
     
                                            </StackPanel>
                                            

                                            <StackPanel Orientation="Horizontal" Grid.Column="2" >
                                                <!-- Minimize -->
                                                <Button Content="—"
                                                        Style="{StaticResource SystemButtonNormal}"
                                                        
                                                        beh:WindowSystemCommandsBehavior.Minimize="True"/>

                                                <!-- Maximize / Restore -->
                                                <Button Content="☐"
                                                        Style="{StaticResource SystemButtonNormal}"
                                                        
                                                        beh:WindowSystemCommandsBehavior.ToggleMaximize="True"/>

                                                <!-- Close -->
                                                <Button Content="✕"
                                                        Style="{StaticResource SystemButtonDanger}"
                                                        
                                                        beh:WindowSystemCommandsBehavior.Close="True"/>
                                            </StackPanel>

                                        </Grid>

                                        <!-- 📦 Main content -->
                                        <ContentPresenter/>

                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        


    </Style>

</ResourceDictionary>