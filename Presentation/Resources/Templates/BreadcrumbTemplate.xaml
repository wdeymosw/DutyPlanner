<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv ="clr-namespace:DutyPlanner.Presentation.Converters">


    <conv:CapitalizeConverter x:Key="CapitalizeConverter"/>
    <DataTemplate x:Key="BreadcrumbTemplate">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- year -->
            <Button
            Content="{Binding DataContext.CurrentYearName,
                              RelativeSource={RelativeSource AncestorType=Window},
                              StringFormat={}{0}}"
                
            Command="{Binding DataContext.OpenYearStatisticsCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
            Style="{StaticResource BreadcrumbButtonStyle}"/>
            <TextBlock Text=" / "/>

            <!-- Month -->
            <Button
            Content="{Binding DataContext.CurrentMonthName,
                      RelativeSource={RelativeSource AncestorType=Window},
                      Converter={StaticResource CapitalizeConverter}}"
            Command="{Binding DataContext.OpenMonthStatisticsCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
            Style="{StaticResource BreadcrumbButtonStyle}"/>


        </StackPanel>
    </DataTemplate>

</ResourceDictionary>