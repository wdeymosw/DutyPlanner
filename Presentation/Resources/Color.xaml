<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="BackgroudColor">#f6f6f6</Color>
    <SolidColorBrush x:Key="BackgroudBrush" Color="{StaticResource BackgroudColor}" />

    <Color x:Key="BackgroundColorLight">#ffffff</Color>
    <SolidColorBrush x:Key="BackgroundBrushLight" Color="{StaticResource BackgroundColorLight}" />

    <Color x:Key="BorderColor">#E0E0E0</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <Color x:Key="MouseOnBottonColor">#E6E6E6</Color>
    <SolidColorBrush x:Key="MouseOnBottonBrush" Color="{StaticResource MouseOnBottonColor}" />

    <Color x:Key="FontColor">#1A1A1A</Color>
    <SolidColorBrush x:Key="FontBrush" Color="{StaticResource FontColor}" />

    <SolidColorBrush x:Key="FontColorWhite" Color="{StaticResource BackgroundColorLight}" />

    <Color x:Key="ButtonFontColor">#454545</Color>
    <SolidColorBrush x:Key="ButtonFontColorBrush" Color="{StaticResource ButtonFontColor}" />

    <Color x:Key="ButtonAlertColor">#BD5454</Color>
    <SolidColorBrush x:Key="ButtonAlertColorBrush" Color="{StaticResource ButtonAlertColor}" />



    <RadialGradientBrush x:Key="WindowShadowBrush">
        <GradientStop Color="#55000000" Offset="0.8"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>


</ResourceDictionary>