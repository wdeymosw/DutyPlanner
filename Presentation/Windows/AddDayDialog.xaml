<Window x:Class="DutyPlanner.Presentation.Windows.AddDayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DutyPlanner.Presentation.Windows"
        mc:Ignorable="d"
        Title="{DynamicResource Dialog_AddDayDialog_Title}" Height="300" Width="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Language="{Binding CalendarLanguage}">
    <DockPanel Margin="10">

        <!-- Календарь -->
        <Calendar x:Name="CalendarControl"  
                  DockPanel.Dock="Top"
                  SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                  DisplayDateStart="{Binding MinDate}"
                  DisplayDateEnd="{Binding MaxDate}"
                  SelectionMode="SingleDate"
                  IsTodayHighlighted="True"/>

        <!-- Кнопки -->
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0">
            <Button Content="{DynamicResource Common_Cancel}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="75" 
                    Height="30"
                    Margin="0,0,5,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{DynamicResource Common_Save}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="75"
                    Height="30"
                    Command="{Binding OkCommand}"/>
        </StackPanel>
    </DockPanel>
</Window>
