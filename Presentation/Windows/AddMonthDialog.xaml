<Window x:Class="DutyPlanner.Presentation.Windows.AddMonthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DutyPlanner.Presentation.Windows"
        mc:Ignorable="d"
        Title="{DynamicResource Dialog_Month_Title}"
        Language="{Binding CalendarLanguage}"
        Height="300" Width="220" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10 10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Margin="0 10">
            <TextBlock Text="{DynamicResource Dialogs_Year}"/>
            <ComboBox ItemsSource="{Binding Years}"
                      SelectedItem="{Binding SelectedYear}" />
            <TextBlock Text="{DynamicResource Dialogs_Month}" Margin="0 10 0 0"/>
            <ComboBox ItemsSource="{Binding Months}"
          SelectedItem="{Binding SelectedMonth}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Month, Converter={StaticResource MonthToNameConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
            <Button Content="{DynamicResource Common_Cancel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="80" 
                    Height="30" 
                    Margin="0 0 10 0" 
                    Command="{Binding CancelCommand}" />
            <Button Content="{DynamicResource Common_Save}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="80" 
                    Height="30" 
                    Command="{Binding OkCommand}" />

        </StackPanel>
        
        
    </Grid>
</Window>
