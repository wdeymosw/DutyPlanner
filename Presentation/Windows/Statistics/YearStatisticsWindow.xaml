<Window x:Class="DutyPlanner.Presentation.Windows.YearStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DutyPlanner.Presentation.Windows"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}"
        Title="YearStatisticsWindow" Height="800" Width="1200">
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header and buttoms -->            
            <RowDefinition Height="*"/> <!-- Content-->
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="3"
                Background="{StaticResource WindowShadowBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2">

            <Border Background="{StaticResource BackgroundBrushLight}"
                    CornerRadius="8"
                    Padding="5">

                <!-- Table Header + buttoms -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" 
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Center">

                        <TextBlock Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                    Foreground="{StaticResource ButtonFontColorBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="5">
                        <Button Content="{DynamicResource Dialogs_ToExel}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Common_Close}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <Border Grid.Row="1"
                Margin="3"
                Background="{StaticResource WindowShadowBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2">
            <Border Background="{StaticResource BackgroundBrushLight}"
                    CornerRadius="8"
                    Padding="5">
                <!-- ===== Scrollable content ===== -->
                <Grid Margin="5">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <!-- ================= HEADER ================= -->

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- User -->
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Common_Users}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <!-- Months -->
                                <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding Months}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="50">
                                                <TextBlock Text="{Binding}"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Total -->
                                <TextBlock Grid.Column="2"
                                           Text="{DynamicResource Dialogs_Total}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ================= ROWS ================= -->

                            <ItemsControl ItemsSource="{Binding Rows}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RowBorder">

                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- User -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding UserName}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Monthes strings -->
                                                <ItemsControl Grid.Column="1"
                                            ItemsSource="{Binding DataContext.Months, RelativeSource={RelativeSource AncestorType=Window}}">

                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>

                                                            <Border Width="50">
                                                                <TextBlock HorizontalAlignment="Center">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource MonthValueConverter}">
                                                                            <!-- month (int) -->
                                                                            <Binding />

                                                                            <!-- row (YearStatisticsRowDto) -->
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                     Path="DataContext"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </Border>

                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>

                                                <!-- Total -->
                                                <TextBlock Grid.Column="2"
                                           Text="{Binding TotalHours}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                            </Grid>

                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BorderBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

    </Grid>
</Window>
