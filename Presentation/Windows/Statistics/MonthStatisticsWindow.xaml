<Window x:Class="DutyPlanner.Presentation.Windows.MonthStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DutyPlanner.Presentation.Windows"
        xmlns:conv="clr-namespace:DutyPlanner.Presentation.Converters"
        Style="{StaticResource AppWindowStyle}"
        Title="MonthStatisticsWindow" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:WeekendBrushConverter x:Key="WeekendBrushConverter" WeekdayBrush="Transparent" WeekendBrush="#FFEFEFEF"/>
        <conv:HoursByDayMultiConverter x:Key="HoursByDayConverter"/>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header and buttoms-->
            <RowDefinition Height="*"/> <!-- Content-->
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="3"
                Background="{StaticResource WindowShadowBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2">

            <Border Background="{StaticResource BackgroundBrushLight}"
                    CornerRadius="8"
                     Padding="5">
                
                <!-- Table Header + buttoms -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" 
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Center">

                        <TextBlock Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ButtonFontColorBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="5">

                        <Button Content="{DynamicResource Dialogs_ToExel}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="60"
                                Command="{Binding ExportExcelCommand}"
                                Margin="0,0,8,0"/>

                        <!-- <Button Content="PDF"
                Command="{Binding ExportPdfCommand}"
                Margin="0,0,8,0"/> -->

                        <Button Content="{DynamicResource Common_Close}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="60"
                                Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Grid>

            </Border>
        </Border>

        <Border Grid.Row="1"
                Margin="3"
                Background="{StaticResource WindowShadowBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2">
            <Border Background="{StaticResource BackgroundBrushLight}"
                    CornerRadius="8"
                    Padding="5">

                <!-- ===== Scrollable content ===== -->
                <Grid Margin="5">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                        <StackPanel>
                            <!-- ================= HEADER ================= -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- User -->
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Common_Users}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <!-- Days -->
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding Days}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="25"
                                                    Background="{Binding ., Converter={StaticResource WeekendBrushConverter}}">
                                                <TextBlock Text="{Binding Day}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Total -->
                                <TextBlock Grid.Column="2"
                                           Text="{DynamicResource Dialogs_Total}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ================= ROWS ================= -->
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- User name -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding UserName}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Hours by day -->
                                            <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding DataContext.Days,
                                                  RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="25"
                                                                Background="{Binding ., Converter={StaticResource WeekendBrushConverter}}">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource HoursByDayConverter}">
                                                                        <!-- day -->
                                                                        <Binding />

                                                                        <!-- row -->
                                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                                                 Path="DataContext"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Total -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TotalHours}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>

            </Border>

        </Border>



    </Grid>






</Window>
