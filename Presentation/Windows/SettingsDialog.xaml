<Window x:Class="DutyPlanner.Presentation.Windows.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DutyPlanner.Presentation.Windows"
        mc:Ignorable="d"
        Title="SettingsDialog" Height="450" Width="400">
    <Grid>
        <StackPanel Margin="16">
            <TextBlock Text="Папка данных"/>
            <StackPanel Margin="10">


                <DockPanel Margin="0,5,0,0">
                    <TextBlock
                        Text="{Binding Editable.DataFolderPath}"
                        VerticalAlignment="Center"
                        Width="260"
                        TextTrimming="CharacterEllipsis"/>

                    <!-- Кнопка выбора -->
                    <Button Content="{DynamicResource Settings_BrowseButton}"
                Margin="8,0,0,0"
                Command="{Binding BrowseDataFolderCommand}"/>
                </DockPanel>
            </StackPanel>

            <CheckBox
                Content="{DynamicResource Settings_OpenPdfAfterExport}"
                IsChecked="{Binding Editable.OpenPdfAfterExport}"
                Margin="5"/>

            <CheckBox
                Content="{DynamicResource Settings_OpenExcelAfterExport}"
                IsChecked="{Binding Editable.OpenExcelAfterExport}"
                Margin="5"/>

            <Label Content="Месяц начала отчетного периода"/>

            <ComboBox ItemsSource="{Binding Months}"
                      SelectedItem="{Binding SelectedMonth}"
                      DisplayMemberPath="Name"/>


            <!-- Language selection -->
            <StackPanel Margin="0,10,0,10">

                <TextBlock Text="{DynamicResource Settings_Language}"
               Margin="0,0,0,6"/>

                <RadioButton
                    Content="{DynamicResource Language_ru}"
                    GroupName="Language"
                    IsChecked="{Binding Editable.Language,
                    Converter={StaticResource LanguageToBoolConverter},
                    ConverterParameter=ru}"/>

                <RadioButton
                    Content="{DynamicResource Language_en}"
                    GroupName="Language"
                    IsChecked="{Binding Editable.Language,
                    Converter={StaticResource LanguageToBoolConverter},
                    ConverterParameter=en}"/>

                <RadioButton
                    Content="{DynamicResource Language_uk}"
                    GroupName="Language"
                    IsChecked="{Binding Editable.Language,
                    Converter={StaticResource LanguageToBoolConverter},
                    ConverterParameter=uk}"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Save}" Command="{Binding OkCommand}"/>
                <Button Content="{DynamicResource Common_Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
