<Window x:Class="DutyPlanner.Presentation.Windows.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DutyPlanner"
        xmlns:views="clr-namespace:DutyPlanner.Presentation.Views"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:beh="clr-namespace:DutyPlanner.Presentation.Behaviors"
        xmlns:vm="clr-namespace:DutyPlanner.Presentation.ViewModels"
        Style="{StaticResource AppWindowStyle}"
        Title="{Binding Title}" 
        Background="Transparent"
        Width="1200" Height="800">


    <Grid>

        <!-- ===== Main Layout ===== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main -->
        </Grid.ColumnDefinitions>

        <!-- ===== TOP MENU ===== -->
        <Menu Grid.Row="0"
          Grid.ColumnSpan="2">
            <MenuItem Header="{DynamicResource Settings_Title}"
                  Command="{Binding OpenSettingsCommand}"/>
        </Menu>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Row="1"
            Grid.Column="0"
            Background="{StaticResource BackgroundBrushLight}">

            <ContentControl Content="{Binding SidebarUsers}"
                        VerticalAlignment="Stretch"/>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1"
          Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Navigation -->
                <RowDefinition Height="*"/>
                <!-- Page -->
            </Grid.RowDefinitions>

            <!-- ===== TOP NAVIGATION ===== -->
            <Grid Grid.Row="0"
              Margin="5"
              VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Month selector -->
                <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource MonthSelectorTemplate}"/>

                <!-- Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Button Content="{DynamicResource MainWindow_AddMonth}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="60"
                            Height="25"
                            Margin="0,0,5,0"
                            Command="{Binding AddMonthCommand}"/>
                    <Button Content="PDF"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="35"     
                            Height="25"
                            Command="{Binding ExportPdfCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ===== PAGE CONTENT ===== -->
            <ContentControl Grid.Row="1"
                        Content="{Binding CurrentPage}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:MonthPageViewModel}">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Header -->
                                <RowDefinition Height="*"/>
                                <!-- Days -->
                            </Grid.RowDefinitions>

                            <!-- Month header -->
                            <Border Grid.Row="0"
                                Margin="3"
                                Background="{StaticResource WindowShadowBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="2">

                                <Border Background="{StaticResource BackgroundBrushLight}"
                                    CornerRadius="8"
                                    Padding="5">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Navigation -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="PageNavigationLeftButton"
                                                    Style="{StaticResource PageNavigationButtonStyle}"
                                                    Command="{Binding DataContext.PrevMonthCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                                                <fa5:FontAwesome Icon="Solid_ArrowLeft" FontSize="16" Margin="6 2"/>
                                            </Button>
                                            <Button x:Name="PageNavigationRightButton"
                                                    Style="{StaticResource PageNavigationButtonStyle}"
                                                    Command="{Binding DataContext.NextMonthCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <fa5:FontAwesome Icon="Solid_ArrowRight" FontSize="16" Margin="6 2"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Breadcrumb -->
                                        <ContentControl Grid.Column="1"
                                                        HorizontalAlignment="Center"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource BreadcrumbTemplate}"/>

                                        <!-- Add day -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="{DynamicResource MainWindow_AddDay}"
                                                Command="{Binding AddDayCommand}"/>
                                    </Grid>

                                </Border>
                            </Border>

                            <!-- Days list -->
                            <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Days}"
                                          ItemTemplate="{StaticResource DayTemplate}"/>
                            </ScrollViewer>

                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

        </Grid>

    </Grid>

</Window>
