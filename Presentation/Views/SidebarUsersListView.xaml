<UserControl x:Class="DutyPlanner.Presentation.Views.SidebarUsersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DutyPlanner.Presentation.Views"
             xmlns:beh="clr-namespace:DutyPlanner.Presentation.Behaviors"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">






        <ListBox ItemsSource="{Binding Users}"
         SelectedItem="{Binding SelectedUser}"
         BorderThickness="0"
         x:Name="UserListBox"
         SelectionMode="Single"
         beh:DragSourceBehavior.IsEnabled="True"
         beh:DragTargetBehavior.IsEnabled="True"
                 
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.CanContentScroll="True"
         VirtualizingStackPanel.IsVirtualizing="True"
         VirtualizingStackPanel.VirtualizationMode="Recycling">

            <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Background" Value="{StaticResource BackgroundBrushLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border 
                                    Background="{StaticResource WindowShadowBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Border CornerRadius="8"
                                                x:Name="RootBorder"
                                                Background="{StaticResource BackgroundBrushLight}">

                                        <ContentPresenter/>

                                    </Border>
                                </Grid>
                            </Border>

                                <ControlTemplate.Triggers>

                                    <!-- Hover -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RootBorder"
                                            Property="Background" Value="{StaticResource BackgroudBrush}"/>
                                        <Setter TargetName="RootBorder" 
                                            Property="BorderBrush" Value="Black"/>
                                    </Trigger>

                                    <!-- Selected -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RootBorder"
                                            Property="Background" Value="{StaticResource BackgroudBrush}"/>
                                        <Setter TargetName="RootBorder" 
                                            Property="BorderBrush" Value="Black"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>


            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="3 5" Width="250">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <fa5:FontAwesome Icon="Regular_User" 
                                         FontSize="14" 
                                         Margin="6 3"/>

                        <!-- Просмотр -->
                        <TextBlock Text="{Binding Name}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityInverse}}" />

                        <!-- Редактирование -->
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="1"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Кнопка -->
                        <Border Grid.Column="2"
                            Background="Transparent">
                            <Button Content="⋯"
                                Width="20"
                                Height="20"
                                Background="Transparent"
                                BorderThickness="0">

                                <!-- Context menue-->
                                <Button.ContextMenu>
                                    <ContextMenu
                                    DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Edit"
                                              Command="{Binding BeginEditCommand}"/>
                                        <MenuItem Header="Save"
                                              Command="{Binding EndEditCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Remove"
                                              Command="{Binding RemoveCommand}"/>
                                        
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>



</UserControl>
